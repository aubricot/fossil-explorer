// Fossil Explorer — GitHub Codespaces configuration
// Runs on a standard 2-core / 8 GB CPU codespace (no GPU needed).
{
  "name": "Fossil Explorer",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },

  // Where setup.sh downloads the data bundle from if data/ is not committed
  // to the repo (e.g. a GitHub Release asset URL). Leave empty if you commit data/.
  "containerEnv": {
    "DATA_URL": ""
  },

  // onCreateCommand (not postCreateCommand) so that PREBUILDS cache the whole
  // install. With prebuilds on, students skip the ~10 minute setup entirely.
  "onCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "codespaces": {
      "openFiles": ["Fossil_Explorer.ipynb"]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "workbench.startupEditor": "none",
        "editor.minimap.enabled": false,
        "notebook.lineNumbers": "off",
        "jupyter.askForKernelRestart": false,
        "files.exclude": {
          "**/__pycache__": true,
          "**/.ipynb_checkpoints": true,
          ".devcontainer": true,
          "scripts": true,
          "teacher": true,
          "requirements.txt": true,
          ".gitignore": true
        }
      }
    }
  }
}
